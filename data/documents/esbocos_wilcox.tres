pages = PackedStringArray("Legendas a lápis, na letra nervosa de Wilcox:\n\n\"Os ângulos estão errados. Desenho uma esquina e ela vira para dentro.\"\n\n\"O limo desce, mas não cai. Nos degraus maiores ele escorre para cima.\"", "\"A porta. Sempre a mesma porta. Não sei se está deitada ou em pé.\"\n\n\"Não desenhar o que está atrás dela.\"")
